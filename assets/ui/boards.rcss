/* The lobby's boards (news, grid status): panels standing beside the login
   panel, pointed at as it is. Their heading stays on the frame; what's
   under it is sunk into it and scrolls (theme.rcss's look). */

body
{
    width: 100%;
    height: 100%;
}

.board
{
    width: 100%;
    height: 100%;
    padding: 0 14dp 14dp 14dp;
    display: flex;
    flex-direction: column;
}

.top
{
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 20dp 16dp 18dp 16dp;
}
.scroll
{
    flex: 1;
    overflow-y: auto;
    padding: 20dp 22dp;
}
.back
{
    font-size: 20dp;
    padding: 7dp 16dp;
    margin-right: 18dp;
}

.subheading
{
    font-size: 16dp;
    color: #c4cff0;
    text-transform: uppercase;
    letter-spacing: 1dp;
    margin: 20dp 0 10dp 0;
}

.quiet { color: #c0cae8; font-size: 22dp; }
.quiet.small { font-size: 17dp; margin-top: 12dp; }

/* News: each entry a card; its border lights orange when pointed at. */
.entry
{
    padding: 18dp 20dp;
    margin-bottom: 14dp;
    cursor: pointer;
}
.entry:hover { background-color: #34468ad8; border-color: #ffc24a; }
.entry.pinned { border-color: #ffc24a90 #1a234680 #121a3a90 #ffc24a70; }
.entry.pinned:hover { border-color: #ffc24a; }
.entry .picture
{
    height: 190dp;
    margin: -18dp -20dp 14dp -20dp;
    border-radius: 14dp 14dp 0 0;
}
.title { font-size: 22dp; color: #ffffff; margin-bottom: 6dp; }
.meta { font-size: 15dp; color: #c0cae8; margin-bottom: 8dp; }
.pin
{
    color: #ffffff;
    font-effect: shadow(0 1dp #7a3e00);
    decorator: linear-gradient(180deg, #fbc85a, #de8a10);
    border-radius: 6dp;
    padding: 2dp 8dp;
    margin-right: 8dp;
    font-size: 13dp;
}
.text { font-size: 17dp; color: #e0e6f6; }

/* An entry, whole. */
.opened .picture
{
    height: 300dp;
    border-radius: 14dp;
    margin-bottom: 18dp;
}
.title.big { font-size: 28dp; }
.text.body { font-size: 19dp; white-space: pre-line; margin-top: 10dp; }

/* A link out (to the web browser). */
.link { margin-top: 24dp; padding-bottom: 6dp; }
.link .primary, .link .button
{
    display: inline-block;
    padding: 11dp 24dp;
}
.hint { font-size: 15dp; color: #c0cae8; margin-top: 10dp; }

/* Grid status. */
.overall
{
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 18dp 20dp;
}
/* Its light: a little raised lamp. */
.overall .dot
{
    width: 18dp;
    height: 18dp;
    border-radius: 10dp;
    margin-right: 16dp;
    background-color: #3ecf6e;
    border-width: 1dp;
    border-color: #ffffff90 #00000060 #00000080 #ffffff60;
    flex-shrink: 0;
}
.overall .what { font-size: 24dp; color: #ffffff; }
.overall.minor .dot { background-color: #f0c040; }
.overall.major .dot { background-color: #f08a3a; }
.overall.critical .dot { background-color: #e5484d; }
.overall.maintenance .dot { background-color: #5a86f0; }

.notice
{
    margin-top: 14dp;
    padding: 16dp 20dp;
    border-left: 5dp #c0cae8;
}
.notice .from { font-size: 15dp; color: #c0cae8; margin-bottom: 6dp; }
.notice.info { border-left-color: #8fb0ff; }
.notice.warning { border-left-color: #f0c040; }
.notice.critical { border-left-color: #e5484d; background-color: #7a1e26c8; }
.notice.incident { border-left-color: #f08a3a; }
.notice.maintenance { border-left-color: #8fb0ff; }
.notice.clickable { cursor: pointer; }
.notice.clickable:hover { background-color: #34468ad8; }

.component
{
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10dp 4dp;
    border-bottom: 1dp #ffffff20;
}
.component .name { flex: 1; font-size: 18dp; color: #ffffff; }
.component .group { font-size: 14dp; color: #c0cae8; }
.state { font-size: 15dp; padding: 3dp 10dp; border-radius: 6dp; color: #10141c; }
.state.degraded { background-color: #f0c040; }
.state.partial { background-color: #f08a3a; }
.state.major { background-color: #e5484d; color: #ffffff; }
.state.maintenance { background-color: #5a86f0; color: #ffffff; }

.checked { margin-top: 18dp; font-size: 14dp; color: #b0bce0; }
