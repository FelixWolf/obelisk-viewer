<rml>
<head>
    <title>Main menu</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="main_menu.rcss"/>
</head>
<body>
<div id="menu" data-model="menu">
    <nav id="tabs">
        <div class="title">TestViewer</div>
        <div class="tab" data-for="t : tabs" data-class-active="t.id == tab"
             data-event-click="tab = t.id; category = ''; chosen = -1"><span>{{ t.name }}</span></div>
        <div class="spacer"></div>
        <div class="close" data-event-click="close">Close</div>
    </nav>

    <div id="page">
        <div data-if="tab == 'home'">
            <div class="card banner">
                <div class="headline">Welcome back</div>
                <div>{{ greeting }}</div>
                <div class="button logout" data-if="inWorld" data-event-click="logOut">Log out</div>
            </div>

            <div class="row">
                <div class="card">
                    <h3>Time</h3>
                    <div class="clock">
                        <div>
                            <div class="time">{{ slt }}</div>
                            <div class="zone">SLT (Pacific)</div>
                            <div class="date">{{ sltDate }}</div>
                        </div>
                        <div>
                            <div class="time">{{ local }}</div>
                            <div class="zone">Local</div>
                            <div class="date">{{ localDate }}</div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <h3>Performance</h3>
                    <div class="stat" data-class-good="viewerFps >= 45" data-class-fair="viewerFps >= 25 && viewerFps < 45" data-class-poor="viewerFps < 25">
                        <span>Viewer FPS</span><span class="value">{{ viewerFpsText }}</span>
                    </div>
                    <div class="stat" data-class-good="regionFps >= 40" data-class-fair="regionFps >= 20 && regionFps < 40" data-class-poor="regionFps < 20">
                        <span>Region FPS</span><span class="value">{{ regionFpsText }}</span>
                    </div>
                    <div class="stat" data-class-good="dilation >= 0.95" data-class-fair="dilation >= 0.8 && dilation < 0.95" data-class-poor="dilation < 0.8">
                        <span>Time dilation</span><span class="value">{{ dilationText }}</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>Region</h3>
                <div class="region-name">{{ region }}</div>
                <div class="muted">{{ position }}</div>
                <div class="placeholder">The map of the region and its neighbours goes here</div>
            </div>
        </div>

        <div data-if="tab == 'destinations'" class="destinations">
            <!-- Three views: the categories, a category's places, a place.
                 Each stays (hidden) while the next is shown, so going back
                 finds it where it was scrolled to. -->
            <div class="places" data-class-hidden="category != ''">
                <div class="places-head">
                    <div>
                        <h2>Destinations</h2>
                    </div>
                    <div class="button" data-event-click="refresh">Refresh</div>
                </div>
                <div class="category" data-for="c : categories"
                     data-event-click="category = c.id; chosen = -1">
                    <div class="shot" data-if="c.image != ''"
                         data-style-decorator="'image(' + c.image + ' cover)'"></div>
                    <div class="shot empty" data-if="c.image == ''"></div>
                    <div class="place-name">{{ c.name }}</div>
                    <div class="people">{{ c.places }}</div>
                </div>
                <div class="note" data-if="categoriesNote != ''">{{ categoriesNote }}</div>
            </div>

            <div class="places" data-if="category != ''" data-class-hidden="chosen >= 0">
                <div class="places-head">
                    <div class="button back" data-event-click="category = ''; chosen = -1">‹ Back</div>
                    <div class="head-text">
                        <h2>{{ categoryName }}</h2>
                        <div class="muted">{{ categoryText }}</div>
                    </div>
                    <div class="button" data-event-click="refresh">Refresh</div>
                </div>
                <div class="note" data-if="placesNote != ''">{{ placesNote }}</div>
                <div class="place" data-for="p : places" data-event-click="chosen = it_index">
                    <div class="shot" data-if="p.image != ''"
                         data-style-decorator="'image(' + p.image + ' cover)'"></div>
                    <div class="shot empty" data-if="p.image == ''"></div>
                    <div class="place-name">{{ p.name }}</div>
                    <div class="place-info">
                        <span data-attr-class="'rating ' + p.rating">{{ p.maturity }}</span>
                        <span class="people">{{ p.people }}</span>
                    </div>
                </div>
                <div class="more" data-if="hasMore" data-event-click="more">Show more</div>
                <div class="note" data-if="loadingMore">Finding more...</div>
            </div>

            <div class="place-page" data-if="category != '' &amp;&amp; chosen >= 0">
                <div class="button back" data-event-click="chosen = -1">‹ Back</div>
                <div class="place-top">
                    <div class="shot hero" data-if="pick.largeImage != ''"
                         data-style-decorator="'image(' + pick.largeImage + ' cover)'"></div>
                    <div class="shot hero" data-if="pick.largeImage == '' &amp;&amp; pick.image != ''"
                         data-style-decorator="'image(' + pick.image + ' cover)'"></div>
                    <div class="shot hero empty" data-if="pick.largeImage == '' &amp;&amp; pick.image == ''"></div>
                    <div class="place-side">
                        <div class="detail-name">{{ pick.name }}</div>
                        <div class="place-info">
                            <span data-attr-class="'rating ' + pick.rating">{{ pick.maturity }}</span>
                            <span class="people">{{ pick.people }}</span>
                        </div>
                        <div class="spacer"></div>
                        <div class="teleport" data-if="inWorld" data-event-click="teleport">Teleport</div>
                        <div class="teleport off" data-if="!inWorld">Log in to teleport</div>
                    </div>
                </div>
                <div class="description"><div class="text">{{ pick.description }}</div></div>
            </div>
        </div>

        <div data-if="tab == 'about'" class="about">
            <div class="card banner">
                <div class="headline">TestViewer</div>
                <div>Version {{ version }}</div>
            </div>
            <div class="card">
                <p>A Second Life viewer, written from scratch. It's free software under the
                   GNU Lesser General Public License, version 2.1; the parts it's built
                   with are under their own licenses, below.</p>
                <p class="muted">{{ builtWith }}</p>
            </div>
            <div class="licenses">
                <div class="license-list">
                    <div class="license-name" data-for="l : licenses"
                         data-class-active="it_index == license"
                         data-event-click="license = it_index">{{ l }}</div>
                </div>
                <div class="license-text"><div class="text">{{ licenseText }}</div></div>
            </div>
        </div>

        <div data-if="tab == 'inventory'" class="destinations">
            <!-- A folder's contents (kept, hidden, while an item's shown). -->
            <div class="places" data-class-hidden="invItemShown">
                <div class="places-head">
                    <div class="button back" data-if="invCrumbs.size > 1" data-event-click="invBack">‹ Back</div>
                    <div class="head-text crumbs">
                        <span class="crumb" data-for="c : invCrumbs" data-event-click="invUp(it_index)"><span class="sep" data-if="it_index > 0">›</span>{{ c }}</span>
                    </div>
                    <div class="button" data-event-click="invRefresh">Refresh</div>
                </div>
                <div class="inv-row" data-for="e : invEntries" data-event-click="invOpen(it_index)">
                    <svg class="icon" data-attr-src="'icons/' + e.icon + '.svg'"></svg>
                    <div class="inv-name">{{ e.name }}</div>
                    <div class="worn" data-if="e.worn">Worn</div>
                    <div class="inv-kind"><span data-if="e.link">Link · </span>{{ e.kind }}<span data-if="e.broken"> (missing)</span></div>
                </div>
                <div class="note" data-if="invNote != ''">{{ invNote }}</div>
            </div>

            <div class="place-page" data-if="invItemShown">
                <div class="button back" data-event-click="invBack">‹ Back</div>
                <div class="place-top">
                    <div class="shot hero" data-if="invItem.image != ''"
                         data-style-decorator="'image(' + invItem.image + ' contain)'"></div>
                    <svg class="icon big" data-if="invItem.image == ''" data-attr-src="'icons/' + invItem.icon + '.svg'"></svg>
                    <div class="place-side">
                        <div class="detail-name">{{ invItem.name }}</div>
                        <div class="muted">{{ invItem.kind }}<span data-if="invItem.link != ''"> · {{ invItem.link }}</span></div>
                        <div class="facts">
                            <div class="stat"><span>Creator</span><span class="value">{{ invItem.creator }}</span></div>
                            <div class="stat"><span>You may</span><span class="value">{{ invItem.permissions }}</span></div>
                            <div class="stat" data-if="invItem.created != ''"><span>Made</span><span class="value">{{ invItem.created }}</span></div>
                        </div>
                        <div class="spacer"></div>
                        <div data-if="invItem.clothing || invItem.bodyPart">
                            <div class="teleport off" data-if="invItem.changing">Working...</div>
                            <div class="teleport off" data-if="!invItem.changing &amp;&amp; invItem.bodyPart &amp;&amp; invItem.worn">Worn</div>
                            <div class="actions" data-if="!invItem.changing &amp;&amp; !invItem.worn">
                                <div class="teleport" data-event-click="invWear">Wear</div>
                                <div class="teleport add" data-if="invItem.clothing" data-event-click="invAdd">Add</div>
                            </div>
                            <div class="teleport detach" data-if="!invItem.changing &amp;&amp; invItem.clothing &amp;&amp; invItem.worn" data-event-click="invTakeOff">Take off</div>
                        </div>
                        <div data-if="invItem.attachable">
                            <div class="teleport off" data-if="invItem.changing">Working...</div>
                            <div class="teleport" data-if="!invItem.changing &amp;&amp; !invItem.worn" data-event-click="invAttach">Attach</div>
                            <div class="teleport detach" data-if="!invItem.changing &amp;&amp; invItem.worn" data-event-click="invDetach">Detach</div>
                        </div>
                    </div>
                </div>
                <div class="description"><div class="text">{{ invItem.description }}</div></div>
            </div>
        </div>

        <div data-if="tab == 'outfits'" class="destinations">
            <!-- The outfits (kept, hidden, while one's shown). -->
            <div class="places" data-class-hidden="outfitPage">
                <div class="places-head">
                    <div>
                        <h2>Outfits</h2>
                        <div class="muted">Those saved in My Outfits</div>
                    </div>
                </div>
                <div class="category outfit-card" data-for="o : outfits" data-event-click="outfitOpen(it_index)">
                    <div class="shot" data-if="o.image != ''"
                         data-style-decorator="'image(' + o.image + ' cover)'"></div>
                    <div class="shot empty" data-if="o.image == ''"></div>
                    <div class="place-name">{{ o.name }}</div>
                    <div class="worn" data-if="o.worn">Worn</div>
                </div>
                <div class="note" data-if="outfitsNote != ''">{{ outfitsNote }}</div>
            </div>

            <div class="place-page" data-if="outfitPage">
                <div class="button back" data-event-click="outfitBack">‹ Back</div>
                <div class="place-top">
                    <div class="shot snapshot" data-if="outfit.image != ''"
                         data-style-decorator="'image(' + outfit.image + ' cover)'"></div>
                    <div class="shot snapshot empty" data-if="outfit.image == ''"></div>
                    <div class="place-side">
                        <div class="detail-name">{{ outfit.name }}</div>
                        <div class="muted" data-if="outfit.worn">The outfit you last put on</div>
                        <div class="spacer"></div>
                        <div class="teleport off" data-if="outfitChanging">Putting it on...</div>
                        <div class="teleport" data-if="!outfitChanging" data-event-click="outfitWear">Wear</div>
                    </div>
                </div>
                <div class="description">
                    <div class="inv-row still" data-for="e : outfitItems">
                        <svg class="icon" data-attr-src="'icons/' + e.icon + '.svg'"></svg>
                        <div class="inv-name">{{ e.name }}</div>
                        <div class="inv-kind">{{ e.kind }}<span data-if="e.broken"> (missing)</span></div>
                    </div>
                    <div class="note" data-if="outfitNote != ''">{{ outfitNote }}</div>
                </div>
            </div>
        </div>

        <!-- Chat: conversations on the left, the chosen one on the right,
             newest at the bottom, and a line to type into. -->
        <div data-if="tab == 'chat'" class="chat">
            <div class="chat-list">
                <div data-for="c : chatConversations"
                     data-attr-class="'conversation' + (c.id == chatOpen ? ' active' : '')"
                     data-event-click="chatOpen = c.id">
                    <span class="conversation-name">{{ c.name }}</span>
                    <span class="unread" data-if="c.unread > 0">{{ c.unread }}</span>
                </div>
            </div>
            <div class="chat-main">
                <div class="chat-head">
                    <div class="chat-title">{{ chatTitle }}</div>
                    <div class="toggle" data-if="chatOpen == 'nearby'" data-class-on="chatShowObjects"
                         data-event-click="chatShowObjects = !chatShowObjects">Objects' chat</div>
                </div>
                <div id="chat-lines" class="chat-lines">
                    <div class="quiet" data-if="chatLines.size == 0">Nothing said nearby yet.</div>
                    <div data-for="l : chatLines" data-attr-class="'chat-line ' + l.kind">
                        <span class="when">{{ l.when }}</span>
                        <span class="who" data-if="l.name != ''">{{ l.name }}</span>
                        <span class="said">{{ l.text }}</span>
                    </div>
                </div>
                <div class="typing" data-if="chatTyping != ''">{{ chatTyping }}</div>
                <div class="chat-input">
                    <input type="text" class="chat-field" maxlength="1023" data-if="!chatHeadset"
                           data-value="chatDraft" data-event-keydown="chatKey"/>
                    <div class="send" data-if="!chatHeadset" data-event-click="chatSend">Send</div>
                    <div class="send wide" data-if="chatHeadset" data-event-click="chatType">Type a message</div>
                </div>
            </div>
        </div>

        <!-- People: friends (online first) or who's nearby (nearest first)
             on the left; the one picked on the right, with what can be done. -->
        <div data-if="tab == 'people'" class="chat people">
            <div class="chat-list people-list">
                <div class="people-switch">
                    <div class="toggle" data-class-on="peopleList == 'friends'" data-event-click="peopleList = 'friends'">Friends</div>
                    <div class="toggle" data-class-on="peopleList == 'nearby'" data-event-click="peopleList = 'nearby'">Nearby</div>
                </div>
                <div class="people-rows">
                    <div class="quiet" data-if="peopleNote != ''">{{ peopleNote }}</div>
                    <div data-for="r : peopleRows"
                         data-attr-class="'conversation person' + (r.id == peopleChosen ? ' active' : '') + (r.online ? ' online' : '')"
                         data-event-click="peopleChosen = r.id">
                        <span class="dot"></span>
                        <span class="conversation-name">{{ r.name }}</span>
                        <span class="person-detail">{{ r.detail }}</span>
                        <span class="friend-mark" data-if="peopleList == 'nearby' &amp;&amp; r.isFriend">Friend</span>
                    </div>
                </div>
            </div>
            <div class="chat-main person-card">
                <div class="quiet" data-if="peopleCard.name == ''">Pick someone to see what you can do.</div>
                <div data-if="peopleCard.name != ''">
                    <div class="detail-name">{{ peopleCard.name }}</div>
                    <div class="muted" data-if="peopleCard.username != ''">{{ peopleCard.username }}</div>
                    <div data-attr-class="'person-status' + (peopleCard.online ? ' online' : '')">{{ peopleCard.status }}</div>
                    <div class="actions person-actions">
                        <div class="teleport" data-event-click="peopleMessage">Message</div>
                        <div class="teleport add" data-if="peopleCard.online" data-event-click="peopleOfferTeleport">Offer teleport</div>
                        <div class="teleport add" data-if="peopleCard.online" data-event-click="peopleRequestTeleport">Ask to teleport</div>
                    </div>
                    <div data-if="peopleCard.isFriend" class="rights">
                        <h3>You let them</h3>
                        <div class="toggle right" data-class-on="peopleCard.givesOnline" data-event-click="peopleRight(1)">See when you're online</div>
                        <div class="toggle right" data-class-on="peopleCard.givesMap" data-event-click="peopleRight(2)">Find you on the map</div>
                        <div class="toggle right" data-class-on="peopleCard.givesModify" data-event-click="peopleRight(4)">Edit, delete or take your objects</div>
                        <div class="muted they">{{ peopleCard.theyLetUs }}</div>
                    </div>
                    <div class="actions friendship" data-if="!peopleCard.isFriend">
                        <div class="teleport add" data-event-click="peopleAddFriend">Offer friendship</div>
                    </div>
                    <div class="friendship" data-if="peopleCard.isFriend">
                        <div class="actions" data-if="!peopleConfirmEnd">
                            <div class="teleport detach" data-event-click="peopleEnd">End friendship</div>
                        </div>
                        <div data-if="peopleConfirmEnd">
                            <div class="muted confirm">End your friendship with {{ peopleCard.name }}?</div>
                            <div class="actions">
                                <div class="teleport detach" data-event-click="peopleEnd">End it</div>
                                <div class="teleport add" data-event-click="peopleKeep">Keep</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="tab == 'parcel'" class="parcel">
            <div data-if="!parcelKnown" class="soon">
                <h2>Parcel</h2>
                <p>Not on a parcel yet: the region says which once we're in.</p>
            </div>
            <div data-if="parcelKnown">
                <div class="parcel-top">
                    <div class="shot snapshot" data-if="parcelImage != ''"
                         data-style-decorator="'image(' + parcelImage + ' fill)'"></div>
                    <div class="shot snapshot empty" data-if="parcelImage == ''"></div>
                    <div class="parcel-side">
                        <div class="detail-name">{{ parcelName }}</div>
                        <div class="muted">{{ parcelWhere }}</div>
                        <div class="facts">
                            <div class="stat"><span>Owner</span><span class="value">{{ parcelOwner }}</span></div>
                            <div class="stat"><span>Group</span><span class="value">{{ parcelGroup }}</span></div>
                            <div class="stat"><span>Area</span><span class="value">{{ parcelArea }}</span></div>
                            <div class="stat"><span>Objects</span><span class="value">{{ parcelPrims }}</span></div>
                        </div>
                        <div class="sale" data-if="parcelSale != ''">{{ parcelSale }}</div>
                    </div>
                </div>
                <div class="rules">
                    <div data-for="r : parcelRules" data-attr-class="'rule ' + r.state">
                        <div class="rule-name">{{ r.name }}</div>
                        <div class="rule-text">{{ r.text }}</div>
                    </div>
                </div>
                <div class="row">
                    <div class="card">
                        <h3>About this parcel</h3>
                        <div class="parcel-text">{{ parcelText }}</div>
                        <div class="muted music" data-if="parcelMusic != ''">Music: {{ parcelMusic }}</div>
                    </div>
                    <div class="card estate">
                        <h3>Estate</h3>
                        <div class="region-name">{{ estateName }}</div>
                        <div class="muted" data-if="estateOwner != ''">Owned by {{ estateOwner }}</div>
                        <div class="muted">{{ estateCovenant }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="tab != 'home' &amp;&amp; tab != 'chat' &amp;&amp; tab != 'people' &amp;&amp; tab != 'destinations' &amp;&amp; tab != 'inventory' &amp;&amp; tab != 'outfits' &amp;&amp; tab != 'parcel' &amp;&amp; tab != 'about'" class="soon">
            <h2>{{ tabName }}</h2>
            <p>Not built yet.</p>
        </div>
    </div>
</div>
</body>
</rml>
