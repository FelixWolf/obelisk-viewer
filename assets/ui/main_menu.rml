<rml>
<head>
    <title>Main menu</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="main_menu.rcss"/>
</head>
<body>
<div id="menu" class="frame" data-model="menu">
    <!-- Who we are on the left (the picture over the tabs), what we have
         and how fast we're drawing on the right. -->
    <header id="top">
        <div id="portrait">
            <div class="rim">
                <div class="picture" data-if="picture != ''"
                     data-style-decorator="'image(' + picture + ' cover)'"></div>
                <svg class="picture none" data-if="picture == ''" src="icons/callingcard.svg"></svg>
            </div>
        </div>
        <div id="who">
            <div class="name" data-if="displayName != ''">{{ displayName }}</div>
            <div class="name" data-if="displayName == ''">{{ appName }}</div>
            <div class="where">{{ tabName }}</div>
        </div>
        <!-- Voice: what it's doing; pressed, the microphone on or off. -->
        <div id="voice" data-if="voice != ''">
            <div class="well"><div class="key" data-class-on="microphone"
                 data-event-click="toggleMicrophone">{{ voice }}</div></div>
        </div>
        <div id="readouts">
            <div class="balance" data-if="balance != ''">{{ balance }}</div>
            <div class="spacer"></div>
            <div class="fps">{{ viewerFpsText }} fps</div>
        </div>
    </header>

    <div id="body">
    <!-- The tabs: each a raised button sunk into a well in the frame. -->
    <nav id="tabs">
        <div class="well" data-for="t : tabs">
            <div class="tab key orange" data-class-active="t.id == tab"
                 data-event-click="tab = t.id; category = ''; chosen = -1"><span>{{ t.name }}</span></div>
        </div>
        <div class="spacer"></div>
        <footer id="foot">
            <div class="well"><div class="key close" data-event-click="close">Close</div></div>
            <div class="well" data-if="inWorld"><div class="key red logout" data-event-click="logOut">Log out</div></div>
        </footer>
    </nav>

    <div id="page" class="inset">
        <div data-if="tab == 'home'">
            <div class="row">
                <div class="card">
                    <h3>Time</h3>
                    <div class="clock">
                        <div>
                            <div class="time">{{ slt }}</div>
                            <div class="zone">SLT (Pacific)</div>
                            <div class="date">{{ sltDate }}</div>
                        </div>
                        <div>
                            <div class="time">{{ local }}</div>
                            <div class="zone">Local</div>
                            <div class="date">{{ localDate }}</div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <h3>Performance</h3>
                    <div class="stat" data-class-good="viewerFps >= 45" data-class-fair="viewerFps >= 25 && viewerFps < 45" data-class-poor="viewerFps < 25">
                        <span>Viewer FPS</span><span class="value">{{ viewerFpsText }}</span>
                    </div>
                    <div class="stat" data-class-good="regionFps >= 40" data-class-fair="regionFps >= 20 && regionFps < 40" data-class-poor="regionFps < 20">
                        <span>Region FPS</span><span class="value">{{ regionFpsText }}</span>
                    </div>
                    <div class="stat" data-class-good="dilation >= 0.95" data-class-fair="dilation >= 0.8 && dilation < 0.95" data-class-poor="dilation < 0.8">
                        <span>Time dilation</span><span class="value">{{ dilationText }}</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>Region</h3>
                <div class="region-name">{{ region }}</div>
                <div class="muted">{{ position }}</div>
                <div class="placeholder">The map of the region and its neighbours goes here</div>
            </div>
        </div>

        <div data-if="tab == 'destinations'" class="destinations">
            <!-- Three views: the categories, a category's places, a place.
                 Each stays (hidden) while the next is shown, so going back
                 finds it where it was scrolled to. -->
            <div class="places" data-class-hidden="category != ''">
                <div class="places-head">
                    <div>
                        <h2>Destinations</h2>
                    </div>
                    <div class="button key" data-event-click="refresh">Refresh</div>
                </div>
                <div class="category" data-for="c : categories"
                     data-event-click="category = c.id; chosen = -1">
                    <div class="shot" data-if="c.image != ''"
                         data-style-decorator="'image(' + c.image + ' cover)'"></div>
                    <div class="shot empty" data-if="c.image == ''"></div>
                    <div class="place-name">{{ c.name }}</div>
                    <div class="people">{{ c.places }}</div>
                </div>
                <div class="note" data-if="categoriesNote != ''">{{ categoriesNote }}</div>
            </div>

            <div class="places" data-if="category != ''" data-class-hidden="chosen >= 0">
                <div class="places-head">
                    <div class="button key back" data-event-click="category = ''; chosen = -1">‹ Back</div>
                    <div class="head-text">
                        <h2>{{ categoryName }}</h2>
                        <div class="muted">{{ categoryText }}</div>
                    </div>
                    <div class="button key" data-event-click="refresh">Refresh</div>
                </div>
                <div class="note" data-if="placesNote != ''">{{ placesNote }}</div>
                <div class="place" data-for="p : places" data-event-click="chosen = it_index">
                    <div class="shot" data-if="p.image != ''"
                         data-style-decorator="'image(' + p.image + ' cover)'"></div>
                    <div class="shot empty" data-if="p.image == ''"></div>
                    <div class="place-name">{{ p.name }}</div>
                    <div class="place-info">
                        <span data-attr-class="'rating ' + p.rating">{{ p.maturity }}</span>
                        <span class="people">{{ p.people }}</span>
                    </div>
                </div>
                <div class="more key" data-if="hasMore" data-event-click="more">Show more</div>
                <div class="note" data-if="loadingMore">Finding more...</div>
            </div>

            <div class="place-page" data-if="category != '' &amp;&amp; chosen >= 0">
                <div class="button key back" data-event-click="chosen = -1">‹ Back</div>
                <div class="place-top">
                    <div class="shot hero" data-if="pick.largeImage != ''"
                         data-style-decorator="'image(' + pick.largeImage + ' cover)'"></div>
                    <div class="shot hero" data-if="pick.largeImage == '' &amp;&amp; pick.image != ''"
                         data-style-decorator="'image(' + pick.image + ' cover)'"></div>
                    <div class="shot hero empty" data-if="pick.largeImage == '' &amp;&amp; pick.image == ''"></div>
                    <div class="place-side">
                        <div class="detail-name">{{ pick.name }}</div>
                        <div class="place-info">
                            <span data-attr-class="'rating ' + pick.rating">{{ pick.maturity }}</span>
                            <span class="people">{{ pick.people }}</span>
                        </div>
                        <div class="spacer"></div>
                        <div class="teleport key orange" data-if="inWorld" data-event-click="teleport">Teleport</div>
                        <div class="teleport key off" data-if="!inWorld">Log in to teleport</div>
                    </div>
                </div>
                <div class="description"><div class="text">{{ pick.description }}</div></div>
            </div>
        </div>

        <div data-if="tab == 'about'" class="about">
            <div class="card banner">
                <div class="headline">{{ appName }}</div>
                <div>Version {{ version }}</div>
            </div>
            <div class="card">
                <p>A Second Life viewer, written from scratch. It's free software under the
                   GNU Lesser General Public License, version 2.1; the parts it's built
                   with are under their own licenses, below.</p>
                <p class="muted">{{ builtWith }}</p>
            </div>
            <div class="licenses">
                <div class="license-list">
                    <div class="license-name" data-for="l : licenses"
                         data-class-active="it_index == license"
                         data-event-click="license = it_index">{{ l }}</div>
                </div>
                <div class="license-text"><div class="text">{{ licenseText }}</div></div>
            </div>
        </div>

        <div data-if="tab == 'inventory'" class="destinations">
            <!-- A folder's contents (kept, hidden, while an item's shown). -->
            <div class="places" data-class-hidden="invItemShown">
                <div class="places-head">
                    <div class="button key back" data-if="invCrumbs.size > 1" data-event-click="invBack">‹ Back</div>
                    <div class="head-text crumbs">
                        <span class="crumb" data-for="c : invCrumbs" data-event-click="invUp(it_index)"><span class="sep" data-if="it_index > 0">›</span>{{ c }}</span>
                    </div>
                    <div class="button key" data-event-click="invRefresh">Refresh</div>
                </div>
                <div class="inv-row" data-for="e : invEntries" data-event-click="invOpen(it_index)">
                    <svg class="icon" data-attr-src="'icons/' + e.icon + '.svg'"></svg>
                    <div class="inv-name">{{ e.name }}</div>
                    <div class="worn" data-if="e.worn">Worn</div>
                    <div class="inv-kind"><span data-if="e.link">Link · </span>{{ e.kind }}<span data-if="e.broken"> (missing)</span></div>
                </div>
                <div class="note" data-if="invNote != ''">{{ invNote }}</div>
            </div>

            <div class="place-page" data-if="invItemShown">
                <div class="button key back" data-event-click="invBack">‹ Back</div>
                <div class="place-top">
                    <div class="shot hero" data-if="invItem.image != ''"
                         data-style-decorator="'image(' + invItem.image + ' contain)'"></div>
                    <svg class="icon big" data-if="invItem.image == ''" data-attr-src="'icons/' + invItem.icon + '.svg'"></svg>
                    <div class="place-side">
                        <div class="detail-name">{{ invItem.name }}</div>
                        <div class="muted">{{ invItem.kind }}<span data-if="invItem.link != ''"> · {{ invItem.link }}</span></div>
                        <div class="facts">
                            <div class="stat"><span>Creator</span><span class="value">{{ invItem.creator }}</span></div>
                            <div class="stat"><span>You may</span><span class="value">{{ invItem.permissions }}</span></div>
                            <div class="stat" data-if="invItem.created != ''"><span>Made</span><span class="value">{{ invItem.created }}</span></div>
                        </div>
                        <div class="spacer"></div>
                        <div data-if="invItem.clothing || invItem.bodyPart">
                            <div class="teleport key off" data-if="invItem.changing">Working...</div>
                            <div class="teleport key off" data-if="!invItem.changing &amp;&amp; invItem.bodyPart &amp;&amp; invItem.worn">Worn</div>
                            <div class="actions" data-if="!invItem.changing &amp;&amp; !invItem.worn">
                                <div class="teleport key orange" data-event-click="invWear">Wear</div>
                                <div class="teleport key" data-if="invItem.clothing" data-event-click="invAdd">Add</div>
                            </div>
                            <div class="teleport key red" data-if="!invItem.changing &amp;&amp; invItem.clothing &amp;&amp; invItem.worn" data-event-click="invTakeOff">Take off</div>
                        </div>
                        <div data-if="invItem.attachable">
                            <div class="teleport key off" data-if="invItem.changing">Working...</div>
                            <div class="teleport key orange" data-if="!invItem.changing &amp;&amp; !invItem.worn" data-event-click="invAttach">Attach</div>
                            <div class="teleport key red" data-if="!invItem.changing &amp;&amp; invItem.worn" data-event-click="invDetach">Detach</div>
                        </div>
                    </div>
                </div>
                <div class="description"><div class="text">{{ invItem.description }}</div></div>
            </div>
        </div>

        <div data-if="tab == 'outfits'" class="destinations">
            <!-- The outfits (kept, hidden, while one's shown). -->
            <div class="places" data-class-hidden="outfitPage">
                <div class="places-head">
                    <div>
                        <h2>Outfits</h2>
                        <div class="muted">Those saved in My Outfits</div>
                    </div>
                </div>
                <div class="category outfit-card" data-for="o : outfits" data-event-click="outfitOpen(it_index)">
                    <div class="shot" data-if="o.image != ''"
                         data-style-decorator="'image(' + o.image + ' cover)'"></div>
                    <div class="shot empty" data-if="o.image == ''"></div>
                    <div class="place-name">{{ o.name }}</div>
                    <div class="worn" data-if="o.worn">Worn</div>
                </div>
                <div class="note" data-if="outfitsNote != ''">{{ outfitsNote }}</div>
            </div>

            <div class="place-page" data-if="outfitPage">
                <div class="button key back" data-event-click="outfitBack">‹ Back</div>
                <div class="place-top">
                    <div class="shot snapshot" data-if="outfit.image != ''"
                         data-style-decorator="'image(' + outfit.image + ' cover)'"></div>
                    <div class="shot snapshot empty" data-if="outfit.image == ''"></div>
                    <div class="place-side">
                        <div class="detail-name">{{ outfit.name }}</div>
                        <div class="muted" data-if="outfit.worn">The outfit you last put on</div>
                        <div class="spacer"></div>
                        <div class="teleport key off" data-if="outfitChanging">Putting it on...</div>
                        <div class="teleport key orange" data-if="!outfitChanging" data-event-click="outfitWear">Wear</div>
                    </div>
                </div>
                <div class="description">
                    <div class="inv-row still" data-for="e : outfitItems">
                        <svg class="icon" data-attr-src="'icons/' + e.icon + '.svg'"></svg>
                        <div class="inv-name">{{ e.name }}</div>
                        <div class="inv-kind">{{ e.kind }}<span data-if="e.broken"> (missing)</span></div>
                    </div>
                    <div class="note" data-if="outfitNote != ''">{{ outfitNote }}</div>
                </div>
            </div>
        </div>

        <!-- Chat: conversations on the left, the chosen one on the right,
             newest at the bottom, and a line to type into. -->
        <div data-if="tab == 'chat'" class="chat">
            <div class="chat-list">
                <div data-for="c : chatConversations"
                     data-attr-class="'conversation' + (c.id == chatOpen ? ' active' : '')"
                     data-event-click="chatOpen = c.id">
                    <span class="conversation-name">{{ c.name }}</span>
                    <span class="unread" data-if="c.unread > 0">{{ c.unread }}</span>
                </div>
            </div>
            <div class="chat-main">
                <div class="chat-head">
                    <div class="chat-title">{{ chatTitle }}</div>
                    <div class="toggle key" data-if="chatOpen == 'nearby'" data-class-on="chatShowObjects"
                         data-event-click="chatShowObjects = !chatShowObjects">Objects' chat</div>
                </div>
                <div id="chat-lines" class="chat-lines">
                    <div class="quiet" data-if="chatLines.size == 0">Nothing said nearby yet.</div>
                    <div data-for="l : chatLines" data-attr-class="'chat-line ' + l.kind">
                        <span class="when">{{ l.when }}</span>
                        <span class="who" data-if="l.name != ''">{{ l.name }}</span>
                        <span class="said">{{ l.text }}</span>
                    </div>
                </div>
                <div class="typing" data-if="chatTyping != ''">{{ chatTyping }}</div>
                <div class="chat-input">
                    <input type="text" class="chat-field field" maxlength="1023" data-if="!chatHeadset"
                           data-value="chatDraft" data-event-keydown="chatKey"/>
                    <div class="send key orange" data-if="!chatHeadset" data-event-click="chatSend">Send</div>
                    <div class="send key orange wide" data-if="chatHeadset" data-event-click="chatType">Type a message</div>
                </div>
            </div>
        </div>

        <!-- People: friends (online first) or who's nearby (nearest first)
             on the left; the one picked on the right, with what can be done. -->
        <div data-if="tab == 'people'" class="chat people">
            <div class="chat-list people-list">
                <div class="people-switch">
                    <div class="toggle key" data-class-on="peopleList == 'friends'" data-event-click="peopleList = 'friends'">Friends</div>
                    <div class="toggle key" data-class-on="peopleList == 'nearby'" data-event-click="peopleList = 'nearby'">Nearby</div>
                </div>
                <div class="people-rows">
                    <div class="quiet" data-if="peopleNote != ''">{{ peopleNote }}</div>
                    <div data-for="r : peopleRows"
                         data-attr-class="'conversation person' + (r.id == peopleChosen ? ' active' : '') + (r.online ? ' online' : '')"
                         data-event-click="peopleChosen = r.id">
                        <span class="dot"></span>
                        <span class="conversation-name">{{ r.name }}</span>
                        <span class="person-detail">{{ r.detail }}</span>
                        <span data-if="r.voice != ''" data-attr-class="'voice-mark ' + r.voice"><span class="bar"></span><span class="bar tall"></span><span class="bar"></span></span>
                        <span class="friend-mark" data-if="peopleList == 'nearby' &amp;&amp; r.isFriend">Friend</span>
                    </div>
                </div>
            </div>
            <div class="chat-main person-card">
                <div class="quiet" data-if="peopleCard.name == ''">Pick someone to see what you can do.</div>
                <div data-if="peopleCard.name != ''">
                    <div class="detail-name">{{ peopleCard.name }}</div>
                    <div class="muted" data-if="peopleCard.username != ''">{{ peopleCard.username }}</div>
                    <div data-attr-class="'person-status' + (peopleCard.online ? ' online' : '')">{{ peopleCard.status }}</div>
                    <div class="actions person-actions">
                        <div class="teleport key orange" data-event-click="peopleMessage">Message</div>
                        <div class="teleport key" data-if="peopleCard.online" data-event-click="peopleOfferTeleport">Offer teleport</div>
                        <div class="teleport key" data-if="peopleCard.online" data-event-click="peopleRequestTeleport">Ask to teleport</div>
                    </div>
                    <div class="actions person-actions" data-if="peopleCard.nearby">
                        <div class="teleport key" data-event-click="peopleResetSkeleton">Reset skeleton</div>
                        <div class="teleport key" data-event-click="peopleResetAnimations">Reset with animations</div>
                    </div>
                    <div data-if="peopleCard.isFriend" class="rights">
                        <h3>You let them</h3>
                        <div class="toggle key right" data-class-on="peopleCard.givesOnline" data-event-click="peopleRight(1)">See when you're online</div>
                        <div class="toggle key right" data-class-on="peopleCard.givesMap" data-event-click="peopleRight(2)">Find you on the map</div>
                        <div class="toggle key right" data-class-on="peopleCard.givesModify" data-event-click="peopleRight(4)">Edit, delete or take your objects</div>
                        <div class="muted they">{{ peopleCard.theyLetUs }}</div>
                    </div>
                    <div class="actions friendship" data-if="!peopleCard.isFriend">
                        <div class="teleport key" data-event-click="peopleAddFriend">Offer friendship</div>
                    </div>
                    <div class="friendship" data-if="peopleCard.isFriend">
                        <div class="actions" data-if="!peopleConfirmEnd">
                            <div class="teleport key red" data-event-click="peopleEnd">End friendship</div>
                        </div>
                        <div data-if="peopleConfirmEnd">
                            <div class="muted confirm">End your friendship with {{ peopleCard.name }}?</div>
                            <div class="actions">
                                <div class="teleport key red" data-event-click="peopleEnd">End it</div>
                                <div class="teleport key" data-event-click="peopleKeep">Keep</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="tab == 'parcel'" class="parcel">
            <div data-if="!parcelKnown" class="soon">
                <h2>Parcel</h2>
                <p>Not on a parcel yet: the region says which once we're in.</p>
            </div>
            <div data-if="parcelKnown">
                <div class="parcel-top">
                    <div class="shot snapshot" data-if="parcelImage != ''"
                         data-style-decorator="'image(' + parcelImage + ' fill)'"></div>
                    <div class="shot snapshot empty" data-if="parcelImage == ''"></div>
                    <div class="parcel-side">
                        <div class="detail-name">{{ parcelName }}</div>
                        <div class="muted">{{ parcelWhere }}</div>
                        <div class="facts">
                            <div class="stat"><span>Owner</span><span class="value">{{ parcelOwner }}</span></div>
                            <div class="stat"><span>Group</span><span class="value">{{ parcelGroup }}</span></div>
                            <div class="stat"><span>Area</span><span class="value">{{ parcelArea }}</span></div>
                            <div class="stat"><span>Objects</span><span class="value">{{ parcelPrims }}</span></div>
                        </div>
                        <div class="sale" data-if="parcelSale != ''">{{ parcelSale }}</div>
                    </div>
                </div>
                <div class="rules">
                    <div data-for="r : parcelRules" data-attr-class="'rule ' + r.state">
                        <div class="rule-name">{{ r.name }}</div>
                        <div class="rule-text">{{ r.text }}</div>
                    </div>
                </div>
                <div class="row">
                    <div class="card">
                        <h3>About this parcel</h3>
                        <div class="parcel-text">{{ parcelText }}</div>
                        <div class="muted music" data-if="parcelMusic != ''">Music: {{ parcelMusic }}</div>
                    </div>
                    <div class="card estate">
                        <h3>Estate</h3>
                        <div class="region-name">{{ estateName }}</div>
                        <div class="muted" data-if="estateOwner != ''">Owned by {{ estateOwner }}</div>
                        <div class="muted">{{ estateCovenant }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="tab == 'media'" class="media">
            <div class="row">
                <div class="card">
                    <h3>Parcel music</h3>
                    <div class="muted" data-if="musicUrl == ''">This parcel has no music.</div>
                    <div data-if="musicUrl != ''">
                        <div class="now-playing" data-if="musicTitle != ''">{{ musicTitle }}</div>
                        <div class="station" data-if="musicStation != ''">{{ musicStation }}</div>
                        <div class="stat"><span>State</span><span class="value">{{ musicState }}</span></div>
                        <div class="stat" data-if="musicDetail != ''"><span>Stream</span><span class="value">{{ musicDetail }}</span></div>
                        <div class="media-error" data-if="musicError != ''">{{ musicError }}</div>
                        <div class="media-url muted">{{ musicUrl }}</div>
                        <div class="actions media-keys">
                            <div class="teleport key orange" data-if="!musicOn" data-event-click="musicPlay">Play</div>
                            <div class="teleport key" data-if="musicOn" data-event-click="musicStop">Stop</div>
                            <div class="key volume" data-event-click="quieter">−</div>
                            <div class="volume-value">{{ musicVolume }}%</div>
                            <div class="key volume" data-event-click="louder">+</div>
                        </div>
                        <div class="muted media-note">{{ musicAuto }}</div>
                    </div>
                </div>
                <div class="card">
                    <h3>Parcel media</h3>
                    <div class="muted" data-if="videoUrl == ''">This parcel has no video or web page.</div>
                    <div data-if="videoUrl != ''">
                        <div class="media-url">{{ videoUrl }}</div>
                        <div class="muted">{{ videoDetail }}</div>
                        <div class="muted media-note">{{ videoNote }}</div>
                    </div>
                </div>
            </div>
            <div class="card">
                <h3>Media on prims around</h3>
                <div class="media-row" data-for="r : primMedia">
                    <div class="stat" data-if="r.object != ''"><span class="media-object">{{ r.object }}</span><span class="value">{{ r.where }}</span></div>
                    <div class="media-face"><span class="face">{{ r.face }}</span> <span class="media-url">{{ r.url }}</span></div>
                    <div class="muted media-note" data-if="r.details != ''">{{ r.details }}</div>
                </div>
                <div class="muted" data-if="primMediaNote != ''">{{ primMediaNote }}</div>
            </div>
        </div>

        <!-- Settings: the pages on the left, the chosen one's settings on the
             right (scrolling), each as its type has it: a check box, a
             number with - and +, a text field, or keys for its choices. -->
        <div data-if="tab == 'settings'" class="chat settings">
            <div class="chat-list settings-pages">
                <div data-for="p, pi : settingPages"
                     data-attr-class="'conversation' + (pi == settingPage ? ' active' : '')"
                     data-event-click="settingPage = pi">
                    <span class="conversation-name">{{ p }}</span>
                </div>
                <div class="settings-file">Saved in {{ settingsFile }}</div>
            </div>
            <div class="chat-main">
                <div class="chat-head"><div class="chat-title">{{ settingPageName }}</div></div>
                <div class="settings-rows">
                    <div class="setting-block" data-for="s, si : settingRows">
                        <h3 class="setting-heading" data-if="s.heading != ''">{{ s.heading }}</h3>
                        <div class="setting">
                            <div class="check setting-main" data-if="s.kind == 'check'" data-class-on="s.on"
                                 data-event-click="settingToggle(si)">
                                <div class="box"></div>
                                <div class="setting-text">
                                    <div class="setting-label">{{ s.label }}</div>
                                    <div class="setting-help">{{ s.description }}</div>
                                    <div class="setting-restart" data-if="s.restart">Takes effect when the viewer next starts.</div>
                                    <div class="setting-restart" data-if="s.overridden">Set for this run by --setting; changing it here keeps the change.</div>
                                </div>
                            </div>
                            <div class="setting-main" data-if="s.kind != 'check'">
                                <div class="setting-text">
                                    <div class="setting-label">{{ s.label }}</div>
                                    <div class="setting-help">{{ s.description }}</div>
                                    <div class="setting-restart" data-if="s.restart">Takes effect when the viewer next starts.</div>
                                    <div class="setting-restart" data-if="s.overridden">Set for this run by --setting; changing it here keeps the change.</div>
                                </div>
                            </div>
                            <div class="setting-control" data-if="s.kind == 'number'">
                                <div class="key step" data-event-click="settingStep(si, -1)">−</div>
                                <input type="text" class="field setting-number" data-if="!settingsHeadset"
                                       data-class-invalid="s.error != ''" data-value="s.text"
                                       data-event-blur="settingDone(si)" data-event-keydown="settingKey(si)"/>
                                <div class="setting-shown setting-number" data-if="settingsHeadset">{{ s.text }}</div>
                                <div class="key step" data-event-click="settingStep(si, 1)">+</div>
                                <div class="setting-unit">{{ s.unit }}</div>
                            </div>
                            <div class="setting-control" data-if="s.kind == 'choice'">
                                <div class="toggle key" data-for="c, ci : s.choices" data-class-on="c.value == s.chosen"
                                     data-event-click="settingChoose(si, ci)">{{ c.label }}</div>
                            </div>
                            <div class="key reset" data-style-visibility="s.isDefault ? 'hidden' : 'visible'"
                                 data-event-click="settingReset(si)">Reset</div>
                        </div>
                        <div class="setting-wide" data-if="s.kind == 'text'">
                            <input type="text" class="field setting-field" data-if="!settingsHeadset"
                                   data-class-invalid="s.error != ''" data-value="s.text"
                                   data-event-blur="settingDone(si)" data-event-keydown="settingKey(si)"/>
                            <div class="setting-shown setting-field" data-if="settingsHeadset">{{ s.text == '' ? s.placeholder : s.text }}</div>
                            <div class="key type" data-if="settingsHeadset" data-event-click="settingKeyboard(si)">Type</div>
                        </div>
                        <div class="setting-list" data-if="s.kind == 'list'">
                            <div class="toggle key" data-for="c, ci : s.choices" data-class-on="c.value == s.chosen"
                                 data-event-click="settingChoose(si, ci)">{{ c.label }}</div>
                        </div>
                        <div class="setting-error" data-if="s.error != ''">{{ s.error }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="tab != 'home' &amp;&amp; tab != 'chat' &amp;&amp; tab != 'people' &amp;&amp; tab != 'destinations' &amp;&amp; tab != 'inventory' &amp;&amp; tab != 'outfits' &amp;&amp; tab != 'parcel' &amp;&amp; tab != 'media' &amp;&amp; tab != 'settings' &amp;&amp; tab != 'about'" class="soon">
            <h2>{{ tabName }}</h2>
            <p>Not built yet.</p>
        </div>
    </div>
    </div>
</div>
</body>
</rml>
