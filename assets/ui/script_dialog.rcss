/* What a script asks of us (a dialog, a text box, permissions, a web page):
   a frame filling its page, who's asking on it; the message (scrolling)
   and the answers sunk into it (theme.rcss's look). */

body
{
    width: 100%;
    height: 100%;
}

.notice
{
    width: 100%;
    height: 100%;
    padding: 16dp 12dp 12dp 12dp;
    display: flex;
    flex-direction: column;
}

.top
{
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    padding: 0 10dp;
    margin-bottom: 12dp;
}
.who { flex: 1; }
.object { font-size: 24dp; color: #f4f6fc; font-effect: shadow(0 2dp #1a2346); }
.owner { font-size: 15dp; color: #b8c4ec; margin-top: 4dp; }
.more
{
    font-size: 14dp;
    color: #ffffff;
    font-effect: shadow(0 1dp #7a3e00);
    decorator: linear-gradient(180deg, #fbc85a, #de8a10);
    border-width: 1dp;
    border-color: #ffe3a0 #c27410 #8e5004 #f6c25a;
    border-radius: 8dp;
    padding: 3dp 10dp;
    margin-left: 12dp;
}

.body
{
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 14dp 16dp 10dp 16dp;
}
.scroll
{
    flex: 1;
    overflow-y: auto;
}
.message { font-size: 18dp; color: #eef1fa; white-space: pre-line; margin-bottom: 10dp; }
.permission
{
    font-size: 18dp;
    color: #ffffff;
    padding: 8dp 12dp;
    margin-bottom: 6dp;
    border-radius: 8dp;
}
.caution
{
    font-size: 16dp;
    color: #ffe0a0;
    margin-top: 10dp;
    padding: 10dp 12dp;
    border-left: 4dp #f0c040;
    background-color: #1c255080;
}
.url { font-size: 16dp; color: #ffe0a0; word-break: break-all; }
.hint { font-size: 14dp; color: #c0cae8; margin-top: 8dp; }
.detail { font-size: 15dp; color: #d0d8f0; margin-bottom: 6dp; word-break: break-all; }

.answers { flex-shrink: 0; margin-top: 12dp; }

/* llDialog's buttons: three to a row, each a key in a well. */
.buttons
{
    display: flex;
    flex-direction: row;
}
.buttons .well
{
    box-sizing: border-box;
    width: 31.5%;
    margin: 0 1.75% 7dp 0;
}
.choice
{
    padding: 8dp 6dp;
    font-size: 17dp;
    border-radius: 8dp;
    white-space: nowrap;
    overflow: hidden;
}

input.field
{
    display: block;
    width: 100%;
    padding: 10dp 12dp;
    margin-bottom: 10dp;
    font-size: 18dp;
}
.typed { font-size: 17dp; color: #ffffff; margin-bottom: 10dp; }

.row { display: flex; flex-direction: row; }
.primary, .secondary
{
    padding: 10dp 22dp;
    margin-right: 10dp;
    font-size: 18dp;
}

.foot
{
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 6dp;
}
.foot .hint { flex: 1; margin-top: 0; }
.ignore
{
    margin-left: auto;
    font-size: 15dp;
    padding: 5dp 14dp;
}
