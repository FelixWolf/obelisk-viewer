/* The login screen: a panel standing in the lobby: the brand on its frame,
   the accounts (and the form) sunk into it (theme.rcss's look). */

body
{
    width: 100%;
    height: 100%;
}

#login
{
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0 14dp 14dp 14dp;
}

.brand
{
    flex-shrink: 0;
    text-align: center;
    padding: 22dp 0 20dp 0;
}

#middle
{
    flex: 1 1 0;
    overflow-y: auto;
    padding: 20dp 22dp;
}

.card { margin-bottom: 16dp; }
.panel { padding: 24dp 26dp; }
h3 { font-size: 22dp; color: #ffffff; margin-bottom: 10dp; text-transform: none; letter-spacing: 0; }
p { margin-bottom: 14dp; }
label
{
    display: block;
    color: #c0cae8;
    font-size: 15dp;
    margin: 12dp 0 6dp 0;
}

/* Text fields. */
input.field
{
    display: block;
    width: 100%;
    padding: 12dp 14dp;
    margin-bottom: 6dp;
    font-size: 18dp;
}

/* An account: its picture, its name, a small Forget. Its border lights
   orange when pointed at. */
.account
{
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 14dp 18dp;
    margin-bottom: 12dp;
    cursor: pointer;
}
.account:hover { background-color: #34468ad8; border-color: #ffc24a; }
/* Its picture on a round rim (theme.rcss); without one, its initial on
   orange. */
.account .rim
{
    width: 66dp;
    height: 66dp;
    flex-shrink: 0;
}
.picture.none
{
    line-height: 66dp;
    text-align: center;
    font-size: 30dp;
    color: #ffffff;
    font-effect: shadow(0 1dp #7a3e00);
    decorator: linear-gradient(180deg, #fbc85a, #de8a10);
}
.who { flex: 1 1 0; margin-left: 18dp; }
.name { font-size: 22dp; color: #ffffff; }
.forget
{
    padding: 5dp 12dp;
    font-size: 14dp;
}

.add
{
    padding: 14dp;
    margin-bottom: 16dp;
    font-size: 18dp;
}

/* Choices (grid, where to start): one picked (pushed in). */
.choices, .start
{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.start-card { padding: 14dp 18dp 6dp 18dp; }
.start-card input.field { margin: 0 0 12dp 0; }
.start-card label { margin-top: 2dp; }
.start .muted { margin: 0 12dp 8dp 0; }
.choice
{
    padding: 7dp 14dp;
    margin: 0 8dp 8dp 0;
    font-size: 17dp;
}

.toggle { margin: 14dp 0 4dp 0; }
.toggle .box { flex-shrink: 0; }
.toggle span { display: block; flex: 0 1 auto; }

.message
{
    max-height: 430dp;
    overflow-y: auto;
    padding: 12dp;
}
.message .prompt-text { white-space: pre-wrap; margin-bottom: 12dp; }
/* The terms, read from their web page. */
.terms .block { margin-bottom: 12dp; font-size: 18dp; }
.terms .block.heading { font-size: 20dp; color: #ffffff; margin-top: 8dp; }
.terms .block.item { margin-left: 22dp; margin-bottom: 6dp; }
.terms .bold { color: #ffffff; font-weight: bold; }
.terms .weblink { color: #ffc24a; cursor: pointer; }
.terms .weblink:hover { color: #ffe0a0; }
.terms-browser
{
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 10dp;
}
.terms-browser .button { margin: 0 12dp 0 0; padding: 7dp 14dp; font-size: 15dp; }

.actions
{
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 18dp;
}
.button, .primary
{
    padding: 11dp 22dp;
    margin-left: 10dp;
}

.busy-text { font-size: 22dp; color: #ffffff; text-align: center; padding: 10dp 0; }

.card.error
{
    position: relative;
    background-color: #7a1e26e0;
    border-color: #ff9a9a80 #3a0a0e #2a0608 #ff8a8a60;
    color: #ffe0e0;
    padding-right: 44dp;
}
.error .reason { color: #ffb0b0; font-size: 14dp; margin-top: 6dp; }
.error .close
{
    position: absolute;
    top: 10dp;
    right: 14dp;
    font-size: 22dp;
    cursor: pointer;
}
/* A newer version of the viewer. */
.update
{
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 14dp 18dp;
}
.update-text { flex: 1 1 0; }
.update .primary { flex-shrink: 0; }

.form-error { color: #ffb0b0; margin-top: 10dp; }
