/* The main menu: tabs down the left, the chosen one's page beside them. */

body
{
    width: 100%;
    height: 100%;
}

#menu
{
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    background-color: #0e1219f0;
    border-radius: 22dp;
    border: 2dp #ffffff1c;
}

#tabs
{
    display: flex;
    flex-direction: column;
    width: 230dp;
    padding: 22dp 14dp;
    background-color: #151b28;
    border-radius: 22dp 0 0 22dp;
    border-right: 1dp #ffffff14;
}

#tabs .title
{
    font-size: 22dp;
    color: #ffffff;
    padding: 6dp 14dp 22dp 14dp;
}

.tab
{
    display: block;
    padding: 14dp 16dp;
    margin-bottom: 6dp;
    border-radius: 12dp;
    color: #b8c2d6;
    cursor: pointer;
    transition: background-color 0.12s linear-in-out;
}
.tab:hover { background-color: #263048; color: #ffffff; }
.tab.active
{
    background-color: #2f5bd0;
    decorator: linear-gradient(180deg, #3a6ae0, #2a4fbe);
    color: #ffffff;
}

#tabs .spacer { flex: 1; }

.close
{
    display: block;
    text-align: center;
    padding: 12dp;
    border-radius: 12dp;
    color: #b8c2d6;
    background-color: #222a3c;
    cursor: pointer;
}
.close:hover { background-color: #8a2a32; color: #ffffff; }

#page
{
    flex: 1;
    padding: 26dp 28dp;
    overflow-y: auto;
}

/* Home: cards, some side by side in rows. */
.card { margin-bottom: 20dp; }
.row
{
    display: flex;
    flex-direction: row;
}
.row .card { flex: 1 1 0; }
.row .card + .card { margin-left: 20dp; }

.clock
{
    display: flex;
    flex-direction: row;
}
.clock > div { flex: 1 1 0; }
.clock .time { font-size: 44dp; color: #ffffff; }
.clock .zone { font-size: 15dp; color: #8b96ab; }
.clock .date { font-size: 15dp; color: #8b96ab; }

.stat
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 6dp 0;
    border-bottom: 1dp #ffffff10;
}
.stat .value { color: #ffffff; }
.stat.good .value { color: #7ee2a0; }
.stat.fair .value { color: #f1d070; }
.stat.poor .value { color: #f08080; }

.region-name { font-size: 26dp; color: #ffffff; }

.placeholder
{
    height: 140dp;
    border-radius: 10dp;
    decorator: linear-gradient(135deg, #24304a, #182030);
    color: #7c879c;
    text-align: center;
    padding-top: 56dp;
}

.banner
{
    border-radius: 14dp;
    decorator: linear-gradient(120deg, #3a6ae0, #8a4fd8);
    padding: 22dp 26dp;
    color: #ffffff;
}
.banner .headline { font-size: 26dp; }

.soon
{
    text-align: center;
    padding-top: 160dp;
    color: #7c879c;
}

/* About: the licenses, a list of names and the chosen one's text. */
.about p { margin-bottom: 8dp; }
.licenses
{
    display: flex;
    flex-direction: row;
    height: 410dp;
}
.license-list
{
    width: 250dp;
    overflow-y: auto;
    margin-right: 16dp;
}
.license-name
{
    padding: 9dp 14dp;
    border-radius: 10dp;
    font-size: 17dp;
    color: #b8c2d6;
    cursor: pointer;
}
.license-name:hover { background-color: #263048; color: #ffffff; }
.license-name.active { background-color: #2f5bd0; color: #ffffff; }
.license-text
{
    flex: 1 1 0;
    overflow-y: auto;
    background-color: #0a0d14;
    border-radius: 12dp;
    border: 1dp #ffffff14;
    padding: 14dp 18dp;
}
.license-text .text
{
    font-size: 14dp;
    color: #c8d0e0;
    white-space: pre-wrap;
}

/* Destinations: the categories as cards (four a row), a category's places
   as cards (three a row), scrolling; a place chosen is shown alone,
   bigger, with its description and Teleport. */
.destinations { height: 100%; }
.hidden { display: none; }
.places
{
    height: 100%;
    overflow-y: auto;
}
.places-head
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 18dp 16dp 0;
}
.places-head h2 { margin: 0; }
.places-head .back { margin: 0 18dp 0 0; }
.head-text
{
    flex: 1 1 0;
    margin-right: 18dp;
}
.head-text .muted { font-size: 16dp; }
.button
{
    padding: 10dp 18dp;
    border-radius: 10dp;
    background-color: #222a3c;
    color: #b8c2d6;
    cursor: pointer;
}
.button:hover { background-color: #2f3a54; color: #ffffff; }
.note
{
    color: #8b96ab;
    padding: 40dp 0;
    text-align: center;
}
/* Its border is always there (clear until pointed at), so nothing moves
   when it shows. */
.place
{
    display: inline-block;
    width: 268dp;
    margin: 0 10dp 12dp 0;
    padding: 10dp;
    border-radius: 14dp;
    background-color: #1a2030e0;
    border: 2dp #00000000;
    cursor: pointer;
    vertical-align: top;
    transition: background-color border-color 0.12s linear-in-out;
}
.place:hover { background-color: #232b40; border-color: #5a86f0; }
.category
{
    display: inline-block;
    width: 198dp;
    margin: 0 10dp 12dp 0;
    padding: 10dp;
    border-radius: 14dp;
    background-color: #1a2030e0;
    border: 2dp #00000000;
    cursor: pointer;
    vertical-align: top;
    transition: background-color border-color 0.12s linear-in-out;
}
.category:hover { background-color: #232b40; border-color: #5a86f0; }
.category .shot { height: 96dp; }
.category .place-name { font-size: 17dp; }
.category .people { font-size: 14dp; }
.more
{
    text-align: center;
    padding: 14dp;
    margin: 4dp 18dp 12dp 0;
    border-radius: 12dp;
    background-color: #222a3c;
    color: #b8c2d6;
    cursor: pointer;
}
.more:hover { background-color: #2f3a54; color: #ffffff; }
.shot
{
    height: 162dp;
    border-radius: 10dp;
}
.shot.empty { decorator: linear-gradient(135deg, #24304a, #182030); }
.place-name
{
    margin-top: 8dp;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
}
.place-info
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4dp;
    font-size: 15dp;
}
.rating
{
    padding: 2dp 8dp;
    border-radius: 6dp;
    font-size: 13dp;
    color: #0e1219;
    background-color: #7ee2a0;
}
.rating.m { background-color: #f1d070; }
.rating.a { background-color: #f08080; }
.people { color: #b8c2d6; }

.place-page
{
    display: flex;
    flex-direction: column;
    height: 100%;
}
.back
{
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 16dp;
}
.place-top
{
    display: flex;
    flex-direction: row;
}
.shot.hero
{
    width: 600dp;
    height: 360dp;
    border-radius: 14dp;
}
.place-side
{
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    margin-left: 24dp;
}
.place-side .spacer { flex: 1; }
.detail-name
{
    font-size: 30dp;
    color: #ffffff;
    margin-bottom: 8dp;
}
.place-side .place-info { font-size: 17dp; }
.description
{
    flex: 1 1 0;
    overflow-y: auto;
    margin-top: 20dp;
}
.description .text
{
    font-size: 17dp;
    color: #c8d0e0;
}
.teleport
{
    text-align: center;
    padding: 16dp;
    border-radius: 12dp;
    color: #ffffff;
    decorator: linear-gradient(180deg, #3a6ae0, #2a4fbe);
    cursor: pointer;
}
.teleport:hover { decorator: linear-gradient(180deg, #4a7af0, #3a5fce); }
.teleport.off
{
    decorator: none;
    background-color: #222a3c;
    color: #7c879c;
    cursor: default;
}

/* Parcel: its picture and facts side by side, its rules as tiles, then
   its description and its estate. */
.parcel-top
{
    display: flex;
    flex-direction: row;
    margin-bottom: 18dp;
}
.shot.snapshot
{
    width: 400dp;
    height: 300dp;
    border-radius: 14dp;
}
.parcel-side
{
    flex: 1 1 0;
    margin-left: 24dp;
}
.facts { margin-top: 14dp; }
.sale
{
    margin-top: 14dp;
    padding: 10dp 14dp;
    border-radius: 10dp;
    background-color: #2a3a24;
    color: #b8f0a0;
}
.rules { margin-bottom: 8dp; }
.rule
{
    display: inline-block;
    width: 150dp;
    margin: 0 8dp 10dp 0;
    padding: 8dp 12dp;
    border-radius: 10dp;
    background-color: #1a2030e0;
    border-left: 4dp #7c879c;
}
.rule.yes { border-left-color: #7ee2a0; }
.rule.group { border-left-color: #f1d070; }
.rule.no { border-left-color: #f08080; }
.rule-name { font-size: 14dp; color: #8b96ab; }
.rule-text { font-size: 16dp; color: #ffffff; }
.parcel-text { font-size: 17dp; color: #c8d0e0; }
.music { margin-top: 10dp; font-size: 15dp; }
.card.estate { flex: 0 0 300dp; }
