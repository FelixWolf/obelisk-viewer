/* The main menu: a frame (who we are along the top, the tabs down the
   left) around the chosen tab's page, sunk into it (theme.rcss's look). */

body
{
    width: 100%;
    height: 100%;
}

#menu
{
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

/* The top: picture, name, L$ and frame rate. */
#top
{
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    height: 118dp;
}
#portrait
{
    width: 214dp;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}
/* The picture, on a round rim (theme.rcss) raised out of the frame; with
   none, a calling card in its place. */
#portrait .rim
{
    width: 92dp;
    height: 92dp;
}
#portrait .picture.none
{
    display: block;
    width: 60dp;
    height: 60dp;
    margin: 16dp;
    image-color: #8c9ed8;
}
#who
{
    flex: 1 1 0;
    padding: 30dp 0 0 8dp;
}
#who .name
{
    font-size: 40dp;
    color: #f4f6fc;
    font-effect: shadow(0 2dp #1a2346);
    white-space: nowrap;
    overflow: hidden;
}
#who .where
{
    font-size: 16dp;
    color: #b8c4ec;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
#readouts
{
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 14dp 26dp 16dp 0;
}
#readouts .spacer { flex: 1; }
#readouts .balance
{
    font-size: 22dp;
    color: #4cf060;
    font-effect: shadow(0 1dp #0c2a10);
}
#readouts .fps
{
    font-size: 18dp;
    color: #e8ecf8;
    font-effect: shadow(0 1dp #1a2346);
}

/* Below: the tabs, and the page. */
#body
{
    flex: 1 1 0;
    display: flex;
    flex-direction: row;
}

#tabs
{
    display: flex;
    flex-direction: column;
    width: 214dp;
    flex-shrink: 0;
    padding: 2dp 0 0 0;
}
#tabs .spacer { flex: 1; }

#tabs .well { margin: 0 22dp 7dp 22dp; }
/* The tabs: orange keys; the chosen one stays pushed in. */
.tab, #foot .key
{
    height: 34dp;
    line-height: 34dp;
    border-radius: 8dp;
    font-size: 18dp;
}

#foot
{
    display: flex;
    flex-direction: row;
    padding: 12dp 16dp 14dp 16dp;
    border-radius: 0 0 0 20dp;
    background-color: #263464;
    border-top: 1dp #1a2346;
}
#foot .well
{
    flex: 1 1 0;
    margin: 0 4dp;
}
/* The page: sunk into the frame, lit from below. */
#page
{
    flex: 1 1 0;
    margin: 0 12dp 12dp 0;
    padding: 24dp 26dp;
    overflow-y: auto;
    border-radius: 18dp 6dp 6dp 6dp;
}

/* Home: cards, some side by side in rows. */
.card { margin-bottom: 20dp; }
.row
{
    display: flex;
    flex-direction: row;
}
.row .card { flex: 1 1 0; }
.row .card + .card { margin-left: 20dp; }

.clock
{
    display: flex;
    flex-direction: row;
}
.clock > div { flex: 1 1 0; }
.clock .time { font-size: 44dp; color: #ffffff; }
.clock .zone { font-size: 15dp; color: #c0cae8; }
.clock .date { font-size: 15dp; color: #c0cae8; }

.stat
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 6dp 0;
    border-bottom: 1dp #ffffff20;
}
.stat .value { color: #ffffff; }
.stat.good .value { color: #7ee2a0; }
.stat.fair .value { color: #f1d070; }
.stat.poor .value { color: #f08080; }

.region-name { font-size: 26dp; color: #ffffff; }

.placeholder
{
    height: 140dp;
    border-radius: 10dp;
    decorator: linear-gradient(135deg, #34448a, #222e64);
    color: #b0bce0;
    text-align: center;
    padding-top: 56dp;
}

.banner
{
    border-radius: 14dp;
    decorator: linear-gradient(120deg, #f0a422, #c8602a);
    border-width: 1dp;
    border-color: #ffe3a0 #8e5004 #7a3e00 #f6c25a;
    font-effect: shadow(0 1dp #7a3e00);
    padding: 22dp 26dp;
    color: #ffffff;
}
.banner .headline { font-size: 26dp; }
.banner { position: relative; }

.soon
{
    text-align: center;
    padding-top: 160dp;
    color: #b0bce0;
}

/* About: the licenses, a list of names and the chosen one's text. */
.about p { margin-bottom: 8dp; }
.licenses
{
    display: flex;
    flex-direction: row;
    height: 410dp;
}
.license-list
{
    width: 250dp;
    overflow-y: auto;
    margin-right: 16dp;
}
.license-name
{
    padding: 9dp 14dp;
    border-radius: 10dp;
    font-size: 17dp;
    color: #dfe5f6;
    cursor: pointer;
}
.license-name:hover { background-color: #ffffff1c; color: #ffffff; }
.license-name.active { background-color: #e8961a; color: #ffffff; }
.license-text
{
    flex: 1 1 0;
    overflow-y: auto;
    background-color: #1c2550;
    border-radius: 12dp;
    border-width: 2dp;
    border-color: #121a3a #6a7ec4 #8496da #161e44;
    padding: 14dp 18dp;
}
.license-text .text
{
    font-size: 14dp;
    color: #c8d0e0;
    white-space: pre-wrap;
}

/* Destinations: the categories as cards (four a row), a category's places
   as cards (three a row), scrolling; a place chosen is shown alone,
   bigger, with its description and Teleport. */
.destinations { height: 100%; }
.hidden { display: none; }
.places
{
    height: 100%;
    overflow-y: auto;
}
.places-head
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 18dp 16dp 0;
}
.places-head h2 { margin: 0; }
.places-head .back { margin: 0 18dp 0 0; }
.head-text
{
    flex: 1 1 0;
    margin-right: 18dp;
}
.head-text .muted { font-size: 16dp; }
.button
{
    padding: 9dp 18dp;
}
.note
{
    color: #c0cae8;
    padding: 40dp 0;
    text-align: center;
}
/* Its border is always there (clear until pointed at), so nothing moves
   when it shows. */
.place
{
    display: inline-block;
    width: 268dp;
    margin: 0 10dp 12dp 0;
    padding: 10dp;
    border-radius: 14dp;
    background-color: #24326ad0;
    border: 2dp #00000000;
    cursor: pointer;
    vertical-align: top;
    transition: background-color border-color 0.12s linear-in-out;
}
.place:hover { background-color: #ffffff1c; border-color: #ffc24a; }
.category
{
    display: inline-block;
    width: 198dp;
    margin: 0 10dp 12dp 0;
    padding: 10dp;
    border-radius: 14dp;
    background-color: #24326ad0;
    border: 2dp #00000000;
    cursor: pointer;
    vertical-align: top;
    transition: background-color border-color 0.12s linear-in-out;
}
.category:hover { background-color: #ffffff1c; border-color: #ffc24a; }
.category .shot { height: 96dp; }
.category .place-name { font-size: 17dp; }
.category .people { font-size: 14dp; }
.more
{
    text-align: center;
    padding: 14dp;
    margin: 4dp 18dp 12dp 0;
}
.shot
{
    height: 162dp;
    border-radius: 10dp;
}
.shot.empty { decorator: linear-gradient(135deg, #34448a, #222e64); }
.place-name
{
    margin-top: 8dp;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
}
.place-info
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4dp;
    font-size: 15dp;
}
.rating
{
    padding: 2dp 8dp;
    border-radius: 6dp;
    font-size: 13dp;
    color: #1c2550;
    background-color: #7ee2a0;
}
.rating.m { background-color: #f1d070; }
.rating.a { background-color: #f08080; }
.people { color: #dfe5f6; }

.place-page
{
    display: flex;
    flex-direction: column;
    height: 100%;
}
.back
{
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 16dp;
}
.place-top
{
    display: flex;
    flex-direction: row;
}
.shot.hero
{
    width: 600dp;
    height: 360dp;
    border-radius: 14dp;
}
.place-side
{
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    margin-left: 24dp;
}
.place-side .spacer { flex: 1; }
.detail-name
{
    font-size: 30dp;
    color: #ffffff;
    margin-bottom: 8dp;
}
.place-side .place-info { font-size: 17dp; }
.description
{
    flex: 1 1 0;
    overflow-y: auto;
    margin-top: 20dp;
}
.description .text
{
    font-size: 17dp;
    color: #c8d0e0;
}
.teleport
{
    text-align: center;
    padding: 15dp;
}

/* Parcel: its picture and facts side by side, its rules as tiles, then
   its description and its estate. */
.parcel-top
{
    display: flex;
    flex-direction: row;
    margin-bottom: 18dp;
}
.shot.snapshot
{
    width: 400dp;
    height: 300dp;
    border-radius: 14dp;
}
.parcel-side
{
    flex: 1 1 0;
    margin-left: 24dp;
}
.facts { margin-top: 14dp; }
.sale
{
    margin-top: 14dp;
    padding: 10dp 14dp;
    border-radius: 10dp;
    background-color: #2a3a24;
    color: #b8f0a0;
}
.rules { margin-bottom: 8dp; }
.rule
{
    display: inline-block;
    width: 150dp;
    margin: 0 8dp 10dp 0;
    padding: 8dp 12dp;
    border-radius: 10dp;
    background-color: #24326ad0;
    border-left: 4dp #b0bce0;
}
.rule.yes { border-left-color: #7ee2a0; }
.rule.group { border-left-color: #f1d070; }
.rule.no { border-left-color: #f08080; }
.rule-name { font-size: 14dp; color: #c0cae8; }
.rule-text { font-size: 16dp; color: #ffffff; }
.parcel-text { font-size: 17dp; color: #c8d0e0; }
.music { margin-top: 10dp; font-size: 15dp; }
.card.estate { flex: 0 0 300dp; }

/* Settings: the Chat tab's layout, the pages on the left and the chosen
   one's settings on the right, scrolling; each a row of its label and
   what it does, and its control (a check box before it; a number, choices
   or Reset after it; a text field under it). */
.settings-pages { display: flex; flex-direction: column; }
.settings-file
{
    margin-top: auto;
    padding: 10dp 6dp 0 6dp;
    font-size: 12dp;
    color: #a8b4dc;
    word-break: break-word;
}
.settings-rows { flex: 1; overflow-y: auto; padding: 4dp 6dp 8dp 2dp; }
.setting-heading { margin: 18dp 0 4dp 0; }
.setting-block:first-child .setting-heading { margin-top: 8dp; }
.setting-block
{
    padding: 10dp 0;
    border-bottom: 1dp #ffffff16;
}
.setting
{
    display: flex;
    flex-direction: row;
    align-items: center;
}
.setting-main { flex: 1 1 0; display: flex; flex-direction: row; align-items: center; }
.setting-main.check .box { flex-shrink: 0; }
.setting-text { flex: 1 1 0; }
.setting-label { font-size: 18dp; color: #ffffff; }
.setting-help { font-size: 14dp; color: #b0bce0; margin-top: 2dp; }
.setting-restart { font-size: 13dp; color: #f1d070; margin-top: 3dp; }
.setting-control
{
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 18dp;
}
.setting-control .toggle { padding: 7dp 14dp; }
.setting-control .toggle + .toggle { margin-left: 8dp; }
.key.step { width: 34dp; padding: 5dp 0; font-size: 18dp; }
.setting-number
{
    width: 96dp;
    margin: 0 6dp;
    padding: 7dp 10dp;
    font-size: 17dp;
    text-align: right;
}
.setting-unit { width: 44dp; margin-left: 8dp; font-size: 15dp; color: #c0cae8; }
.key.reset { margin-left: 14dp; padding: 6dp 12dp; font-size: 14dp; flex-shrink: 0; }
.setting-wide
{
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 8dp;
}
.setting-field
{
    flex: 1 1 0;
    padding: 8dp 12dp;
    font-size: 16dp;
}
.setting-shown
{
    box-sizing: border-box;
    border-radius: 10dp;
    background-color: #1c2550;
    border-width: 1dp;
    border-color: #121a3a #6a7ec4 #8496da #161e44;
    color: #ffffff;
}
.key.type { margin-left: 10dp; padding: 7dp 18dp; }
input.field.invalid, input.field.invalid:focus { border-color: #f08080; }
.setting-error { margin-top: 6dp; font-size: 14dp; color: #f08080; }
