/* The main menu: a frame (who we are along the top, the tabs down the
   left) around the chosen tab's page, sunk into it (theme.rcss's look). */

body
{
    width: 100%;
    height: 100%;
}

#menu
{
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

/* The top: picture, name, L$ and frame rate. */
#top
{
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    height: 118dp;
}
#portrait
{
    width: 214dp;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}
/* The picture, on a round rim (theme.rcss) raised out of the frame; with
   none, a calling card in its place. */
#portrait .rim
{
    width: 92dp;
    height: 92dp;
}
#portrait .picture.none
{
    display: block;
    width: 60dp;
    height: 60dp;
    margin: 16dp;
    image-color: #8c9ed8;
}
#who
{
    flex: 1 1 0;
    padding: 30dp 0 0 8dp;
}
#who .name
{
    font-size: 40dp;
    color: #f4f6fc;
    font-effect: shadow(0 2dp #1a2346);
    white-space: nowrap;
    overflow: hidden;
}
#who .where
{
    font-size: 16dp;
    color: #b8c4ec;
    text-transform: uppercase;
    letter-spacing: 1dp;
}
#readouts
{
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 14dp 26dp 16dp 0;
}
#readouts .spacer { flex: 1; }
#readouts .balance
{
    font-size: 22dp;
    color: #4cf060;
    font-effect: shadow(0 1dp #0c2a10);
}
#readouts .fps
{
    font-size: 18dp;
    color: #e8ecf8;
    font-effect: shadow(0 1dp #1a2346);
}

/* Below: the tabs, and the page. */
#body
{
    flex: 1 1 0;
    display: flex;
    flex-direction: row;
}

#tabs
{
    display: flex;
    flex-direction: column;
    width: 214dp;
    flex-shrink: 0;
    padding: 2dp 0 0 0;
}
#tabs .spacer { flex: 1; }

#tabs .well { margin: 0 22dp 7dp 22dp; }
/* The tabs: orange keys; the chosen one stays pushed in. */
.tab, #foot .key
{
    height: 34dp;
    line-height: 34dp;
    border-radius: 8dp;
    font-size: 18dp;
}

#foot
{
    display: flex;
    flex-direction: row;
    padding: 12dp 16dp 14dp 16dp;
    border-radius: 0 0 0 20dp;
    background-color: #263464;
    border-top: 1dp #1a2346;
}
#foot .well
{
    flex: 1 1 0;
    margin: 0 4dp;
}
/* The page: sunk into the frame, lit from below. */
#page
{
    flex: 1 1 0;
    margin: 0 12dp 12dp 0;
    padding: 24dp 26dp;
    overflow-y: auto;
    border-radius: 18dp 6dp 6dp 6dp;
}

/* Home: cards, some side by side in rows. */
.card { margin-bottom: 20dp; }
.row
{
    display: flex;
    flex-direction: row;
}
.row .card { flex: 1 1 0; }
.row .card + .card { margin-left: 20dp; }

.clock
{
    display: flex;
    flex-direction: row;
}
.clock > div { flex: 1 1 0; }
.clock .time { font-size: 44dp; color: #ffffff; }
.clock .zone { font-size: 15dp; color: #c0cae8; }
.clock .date { font-size: 15dp; color: #c0cae8; }

.stat
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 6dp 0;
    border-bottom: 1dp #ffffff20;
}
.stat .value { color: #ffffff; }
.stat.good .value { color: #7ee2a0; }
.stat.fair .value { color: #f1d070; }
.stat.poor .value { color: #f08080; }

.region-name { font-size: 26dp; color: #ffffff; }

.placeholder
{
    height: 140dp;
    border-radius: 10dp;
    decorator: linear-gradient(135deg, #34448a, #222e64);
    color: #b0bce0;
    text-align: center;
    padding-top: 56dp;
}

.banner
{
    border-radius: 14dp;
    decorator: linear-gradient(120deg, #f0a422, #c8602a);
    border-width: 1dp;
    border-color: #ffe3a0 #8e5004 #7a3e00 #f6c25a;
    font-effect: shadow(0 1dp #7a3e00);
    padding: 22dp 26dp;
    color: #ffffff;
}
.banner .headline { font-size: 26dp; }
.banner { position: relative; }

.soon
{
    text-align: center;
    padding-top: 160dp;
    color: #b0bce0;
}

/* About: the licenses, a list of names and the chosen one's text. */
.about p { margin-bottom: 8dp; }
.licenses
{
    display: flex;
    flex-direction: row;
    height: 410dp;
}
.license-list
{
    width: 250dp;
    overflow-y: auto;
    margin-right: 16dp;
}
.license-name
{
    padding: 9dp 14dp;
    border-radius: 10dp;
    font-size: 17dp;
    color: #dfe5f6;
    cursor: pointer;
}
.license-name:hover { background-color: #ffffff1c; color: #ffffff; }
.license-name.active { background-color: #e8961a; color: #ffffff; }
.license-text
{
    flex: 1 1 0;
    overflow-y: auto;
    background-color: #1c2550;
    border-radius: 12dp;
    border-width: 2dp;
    border-color: #121a3a #6a7ec4 #8496da #161e44;
    padding: 14dp 18dp;
}
.license-text .text
{
    font-size: 14dp;
    color: #c8d0e0;
    white-space: pre-wrap;
}

/* Destinations: the categories as cards (four a row), a category's places
   as cards (three a row), scrolling; a place chosen is shown alone,
   bigger, with its description and Teleport. */
.destinations { height: 100%; }
.hidden { display: none; }
.places
{
    height: 100%;
    overflow-y: auto;
}
.places-head
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 0 18dp 16dp 0;
}
.places-head h2 { margin: 0; }
.places-head .back { margin: 0 18dp 0 0; }
.head-text
{
    flex: 1 1 0;
    margin-right: 18dp;
}
.head-text .muted { font-size: 16dp; }
.button
{
    padding: 9dp 18dp;
}
.note
{
    color: #c0cae8;
    padding: 40dp 0;
    text-align: center;
}
/* Its border is always there (clear until pointed at), so nothing moves
   when it shows. */
.place
{
    display: inline-block;
    width: 268dp;
    margin: 0 10dp 12dp 0;
    padding: 10dp;
    border-radius: 14dp;
    background-color: #24326ad0;
    border: 2dp #00000000;
    cursor: pointer;
    vertical-align: top;
    transition: background-color border-color 0.12s linear-in-out;
}
.place:hover { background-color: #ffffff1c; border-color: #ffc24a; }
.category
{
    display: inline-block;
    width: 198dp;
    margin: 0 10dp 12dp 0;
    padding: 10dp;
    border-radius: 14dp;
    background-color: #24326ad0;
    border: 2dp #00000000;
    cursor: pointer;
    vertical-align: top;
    transition: background-color border-color 0.12s linear-in-out;
}
.category:hover { background-color: #ffffff1c; border-color: #ffc24a; }
.category .shot { height: 96dp; }
.category .place-name { font-size: 17dp; }
.category .people { font-size: 14dp; }
.more
{
    text-align: center;
    padding: 14dp;
    margin: 4dp 18dp 12dp 0;
}
.shot
{
    height: 162dp;
    border-radius: 10dp;
}
.shot.empty { decorator: linear-gradient(135deg, #34448a, #222e64); }
.place-name
{
    margin-top: 8dp;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
}
.place-info
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4dp;
    font-size: 15dp;
}
.rating
{
    padding: 2dp 8dp;
    border-radius: 6dp;
    font-size: 13dp;
    color: #1c2550;
    background-color: #7ee2a0;
}
.rating.m { background-color: #f1d070; }
.rating.a { background-color: #f08080; }
.people { color: #dfe5f6; }

.place-page
{
    display: flex;
    flex-direction: column;
    height: 100%;
}
.back
{
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 16dp;
}
.place-top
{
    display: flex;
    flex-direction: row;
}
.shot.hero
{
    width: 600dp;
    height: 360dp;
    border-radius: 14dp;
}
.place-side
{
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    margin-left: 24dp;
}
.place-side .spacer { flex: 1; }
.detail-name
{
    font-size: 30dp;
    color: #ffffff;
    margin-bottom: 8dp;
}
.place-side .place-info { font-size: 17dp; }
.description
{
    flex: 1 1 0;
    overflow-y: auto;
    margin-top: 20dp;
}
.description .text
{
    font-size: 17dp;
    color: #c8d0e0;
}
.teleport
{
    text-align: center;
    padding: 15dp;
}

/* Parcel: its picture and facts side by side, its rules as tiles, then
   its description and its estate. */
.parcel-top
{
    display: flex;
    flex-direction: row;
    margin-bottom: 18dp;
}
.shot.snapshot
{
    width: 400dp;
    height: 300dp;
    border-radius: 14dp;
}
.parcel-side
{
    flex: 1 1 0;
    margin-left: 24dp;
}
.facts { margin-top: 14dp; }
.sale
{
    margin-top: 14dp;
    padding: 10dp 14dp;
    border-radius: 10dp;
    background-color: #2a3a24;
    color: #b8f0a0;
}
.rules { margin-bottom: 8dp; }
.rule
{
    display: inline-block;
    width: 150dp;
    margin: 0 8dp 10dp 0;
    padding: 8dp 12dp;
    border-radius: 10dp;
    background-color: #24326ad0;
    border-left: 4dp #b0bce0;
}
.rule.yes { border-left-color: #7ee2a0; }
.rule.group { border-left-color: #f1d070; }
.rule.no { border-left-color: #f08080; }
.rule-name { font-size: 14dp; color: #c0cae8; }
.rule-text { font-size: 16dp; color: #ffffff; }
.parcel-text { font-size: 17dp; color: #c8d0e0; }
.music { margin-top: 10dp; font-size: 15dp; }
.card.estate { flex: 0 0 300dp; }

/* Inventory: where we are (crumbs), then a folder's lines: an icon for
   what each is, its name, its kind. */
.crumbs { font-size: 22dp; }
.crumb { color: #dfe5f6; cursor: pointer; }
.crumb:hover { color: #ffffff; }
.crumb .sep { color: #a8b4dc; margin: 0 8dp; }
.inv-row
{
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10dp 12dp;
    margin: 0 18dp 4dp 0;
    border-radius: 10dp;
    border: 2dp #00000000;
    cursor: pointer;
}
.inv-row:hover { background-color: #ffffff1c; border-color: #ffc24a; }
.inv-name
{
    flex: 1 1 0;
    margin-left: 14dp;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
}
.inv-kind { font-size: 15dp; color: #c0cae8; margin-left: 14dp; }
.icon
{
    /* An inventory kind's icon (icons/<kind>.svg), drawn at the size it's
       laid out at. */
    width: 30dp;
    height: 30dp;
    margin: 0 8dp;
}
.icon.big
{
    width: 140dp;
    height: 140dp;
    margin: 0 30dp;
}
.worn
{
    padding: 2dp 8dp;
    border-radius: 6dp;
    font-size: 13dp;
    color: #1c2550;
    background-color: #7ee2a0;
    margin-left: 10dp;
}
.actions
{
    display: flex;
    flex-direction: row;
}
.actions .teleport { flex: 1 1 0; }
.actions .teleport + .teleport { margin-left: 10dp; }

/* Outfits: cards like the categories', then one alone with its items. */
.outfit-card .shot { height: 150dp; }
.outfit-card .worn { display: inline-block; margin: 4dp 0 0 0; }
.inv-row.still { cursor: default; }
.inv-row.still:hover { background-color: transparent; border-color: #00000000; }
.place-page .shot.snapshot { width: 360dp; height: 270dp; }

/* Chat: conversations on the left, the chosen one's lines (newest at the
   bottom, scrolling), and a line to type into. */
.chat
{
    height: 100%;
    display: flex;
    flex-direction: row;
}
.chat-list
{
    width: 230dp;
    flex-shrink: 0;
    margin-right: 22dp;
}
.conversation
{
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12dp 14dp;
    margin-bottom: 6dp;
    border-radius: 12dp;
    color: #dfe5f6;
    cursor: pointer;
}
.conversation:hover { background-color: #ffffff0c; color: #ffffff; }
.conversation.active { background-color: #ffffff24; color: #ffffff; }
.conversation-name { flex: 1; }
.unread
{
    font-size: 14dp;
    color: #ffffff;
    background-color: #e8961a;
    border-radius: 9dp;
    padding: 2dp 8dp;
}
.chat-main
{
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #1c2550a0;
    border-radius: 16dp;
    border-width: 2dp;
    border-color: #121a3a #6a7ec4 #8496da #161e44;
    padding: 16dp 18dp;
}
.chat-head
{
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 12dp;
    border-bottom: 1dp #ffffff24;
}
.chat-title { flex: 1; font-size: 24dp; color: #ffffff; }
.toggle
{
    font-size: 15dp;
    padding: 5dp 12dp;
}
.chat-lines
{
    flex: 1;
    overflow-y: auto;
    padding: 10dp 0;
}
.chat-lines .quiet { color: #b0bce0; padding-top: 20dp; text-align: center; }
.chat-line
{
    font-size: 18dp;
    color: #e8ecf4;
    padding: 3dp 4dp;
}
.chat-line .when { font-size: 13dp; color: #a8b4dc; margin-right: 8dp; }
.chat-line .who { color: #8fb0ff; margin-right: 6dp; }
.chat-line.object .who { color: #7fd0b0; }
.chat-line.object .said { color: #b9c9c2; }
.chat-line.owner
{
    background-color: #f0c04014;
    border-left: 3dp #f0c040;
    padding-left: 8dp;
}
.chat-line.owner .who { color: #f0c040; }
.chat-line.system .said { color: #c4cff0; }
.chat-input
{
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-top: 12dp;
    border-top: 1dp #ffffff24;
}
input.chat-field
{
    flex: 1;
    padding: 10dp 12dp;
    font-size: 18dp;
}
.send
{
    margin-left: 10dp;
    padding: 9dp 20dp;
}
.send.wide { margin-left: 0; }
.chat-line.self .who { color: #c0a0ff; }
.typing { font-size: 14dp; color: #c0cae8; padding: 0 4dp 6dp 4dp; flex-shrink: 0; }

/* People: the Chat tab's layout, with friends or who's nearby on the left
   and the one picked on the right. */
.people-list { width: 300dp; display: flex; flex-direction: column; }
.people-switch { display: flex; flex-direction: row; margin-bottom: 12dp; flex-shrink: 0; }
.people-switch .toggle { flex: 1 1 0; text-align: center; }
.people-switch .toggle + .toggle { margin-left: 8dp; }
.people-rows { flex: 1; overflow-y: auto; }
.people-rows .quiet { color: #b0bce0; padding: 20dp 10dp; text-align: center; }
.person .dot
{
    width: 9dp;
    height: 9dp;
    border-radius: 5dp;
    margin-right: 10dp;
    background-color: #7a86b0;
    flex-shrink: 0;
}
.person.online .dot { background-color: #4cc070; }
.person-detail { font-size: 14dp; color: #b0bce0; margin-left: 8dp; }
.friend-mark
{
    font-size: 12dp;
    color: #c0a0ff;
    margin-left: 8dp;
    padding: 1dp 6dp;
    border-radius: 6dp;
    border: 1dp #c0a0ff60;
}
.person-card { padding: 22dp 24dp; }
.person-card .quiet { color: #b0bce0; padding-top: 30dp; text-align: center; }
.person-status { color: #c0cae8; margin: 8dp 0 18dp 0; }
.person-status.online { color: #4cc070; }
.person-actions { margin-bottom: 22dp; }
.rights h3 { margin: 0 0 10dp 0; }
.rights .right { margin-bottom: 8dp; padding: 10dp 14dp; }
.rights .they { margin-top: 8dp; font-size: 15dp; }
.person-card .confirm { margin-bottom: 10dp; }
.person-card .friendship { margin-top: 26dp; }

