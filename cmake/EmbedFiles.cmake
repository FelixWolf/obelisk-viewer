# Turns binary files into a C++ header of byte arrays.
#   cmake -DOUTPUT=out.hpp -DNAMESPACE=a::b -DENTRIES="name=path;name=path" -P EmbedFiles.cmake
set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#pragma once\n\n#include <cstdint>\n\nnamespace ${NAMESPACE}\n{\n")
foreach(entry IN LISTS ENTRIES)
  string(FIND "${entry}" "=" split)
  string(SUBSTRING "${entry}" 0 ${split} name)
  math(EXPR start "${split} + 1")
  string(SUBSTRING "${entry}" ${start} -1 path)
  file(READ "${path}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
  string(APPEND content "\ninline constexpr uint8_t ${name}[] = {\n    ${bytes}\n};\n")
endforeach()
string(APPEND content "\n} // namespace ${NAMESPACE}\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
